# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.eggs/
*.egg-info/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.keystore
*.jks

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
.DS_Store
.codex/
.kilo/

# Android & Gradle
.gradle/
.kotlin/
build/
**/build/
*.iml
local.properties

# Application Data & Databases (never commit personal DB or runtime data)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
data/*
!data/.gitkeep

# Invoices & Images (uploaded receipts & PDFs — never commit)
invoice/
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.pdf
# ...but keep app source image assets tracked (Android launcher icon, web images)
!android-app/**/*.png
!android-app/**/*.jpg
!android-app/**/*.jpeg
!android-app/**/*.gif
!android-app/**/*.webp
!web/**/*.png
!web/**/*.jpg
!web/**/*.jpeg
!web/**/*.gif
!web/**/*.webp

# Web frontend build artifacts (deps + build output)
node_modules/
web/node_modules/
web/dist/
web/.vite/
web/*.local
